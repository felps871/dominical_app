{
  "expo": {
    "name": "Dominical App",
    "slug": "dominical-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_App.png",
    "scheme": "dominicalapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo_App.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_App.png",
        "backgroundImage": "./assets/images/logo_tela.png",
        "monochromeImage": "./assets/images/logo_tela.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.felps_452.dominicalapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f74e980c-dbd4-4919-b253-523e97f5c07f"
      }
    }
  }
}
